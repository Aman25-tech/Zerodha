<% layout("/layouts/boilerplate") %>

<div class="otp-page">
    <div class="otp-hero fade-in">
        <div class="container">
            <h1>Enter OTP</h1>
            <p class="subtitle">Enter the OTP sent to your mobile</p>
        </div>
    </div>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="otp-form-container fade-in-left">
                    <h2>OTP Verification</h2>
                    
                    <% if (success && success.length > 0) { %>
                        <div class="alert alert-success" role="alert">
                            <%= success %>
                        </div>
                    <% } %>
                    
                    <% if (error && error.length > 0) { %>
                        <div class="alert alert-danger" role="alert">
                            <%= error %>
                        </div>
                    <% } %>

                    <form class="otp-form" action="/verify-otp" method="POST">
                        <div class="form-group mb-3">
                            <label for="otp" class="form-label">Enter OTP</label>
                            <input type="text" id="otp" name="otp" class="form-control" placeholder="000000" maxlength="6" required>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 mb-3">Verify OTP</button>
                    </form>

                    <p class="text-center">
                        <a href="/send-otp">Resend OTP</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>